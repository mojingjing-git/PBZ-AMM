{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PBZ-AMM",
  "version": "0.1.0",
  "identifier": "io.github.pbz-amm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PBZ-AMM · 影之刃零模组枢机",
        "width": 1240,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 660,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
